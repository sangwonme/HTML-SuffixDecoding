# Environments and caches (re-created by setup; see README.md)
.venv/
.cache/
__pycache__/
*.pyc
.env
.gpu_busy

# Model weights (re-download: scripts/download_models.py)
models/

# Raw data (re-download: scripts/download_data.py)
data/raw/

# Regenerable large processed data (scripts/build_dataset.py, deterministic)
data/processed/screenshots/
data/processed/train_pool.jsonl
data/processed/external/design2code.jsonl

# Pickle caches and backups (recomputed by the scripts)
*.pkl
*.bak
